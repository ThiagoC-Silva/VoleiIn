# Variáveis do Supabase local lidas pelo config.toml com env() (docs/setup.md,
# seções 5.2 e 6.2). Copie para supabase/.env e preencha. O arquivo .env nunca
# vai para o Git.

# Login com Google: o ID do cliente web (identificador público, o mesmo
# GOOGLE_WEB_CLIENT_ID do app) e o segredo dele. Sem eles, o resto do app
# funciona no local; só o login com Google falha.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
